rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'planTier', 'createdAt'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 100
        && data.planTier is string && data.planTier.size() <= 32
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidExperiment(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'structureId', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100
        && data.structureId is string && data.structureId.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidStudySession(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'topic', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid
        && data.subject is string && data.subject.size() <= 100
        && data.topic is string && data.topic.size() <= 150
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isSignedIn() && isOwner(userId) && isValidId(userId);

      match /bioscience_experiments/{experimentId} {
        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidId(experimentId) && isValidExperiment(request.resource.data, userId);
        allow update: if isSignedIn() && isOwner(userId) && isValidId(experimentId) && isValidExperiment(request.resource.data, userId);
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(experimentId);
      }

      match /study_sessions/{sessionId} {
        allow get: if isSignedIn() && isOwner(userId);
        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidId(sessionId) && isValidStudySession(request.resource.data, userId);
        allow update: if isSignedIn() && isOwner(userId) && isValidId(sessionId) && isValidStudySession(request.resource.data, userId);
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(sessionId);
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
